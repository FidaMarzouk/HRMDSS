# ENOVA Assistant agent service. Copy to .env and fill in.
AGENT_PORT=8090
# Where the HRMS backend runs (the agent only calls /api/assistant/tools there).
BACKEND_URL=http://localhost:8081
# Same value as AGENT_SHARED_SECRET in Backend/.env (any long random string).
AGENT_SHARED_SECRET=
GROQ_API_KEY=
# Model routing: router picks tool groups, main plans and calls tools, guard flags prompt injections.
AGENT_MAIN_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
AGENT_ROUTER_MODEL=openai/gpt-oss-20b
AGENT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
AGENT_GUARD_THRESHOLD=0.9
# The agent's own database for conversation state (LangGraph checkpoints). Not the HR database.
AGENT_MONGO_URI=mongodb://localhost:27017
AGENT_MONGO_DB=enova_agent
AGENT_MAX_MODEL_CALLS=7
# LangSmith tracing. Inputs and outputs are hidden by default (metadata, timings and tool names only).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enova-assistant
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
