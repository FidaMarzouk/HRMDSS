# Server
PORT=8081
NODE_ENV=development
# Origin of the React app (CORS, Socket.IO and links in emails)
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/hrms

# Auth: use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Email (Gmail: create an App Password; never use the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hr@example.com
SMTP_PASS=

# ENOVA Assistant (Groq-hosted model)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Local embedding model used for retrieval (downloaded on first start)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
